# ============================================================
# Smart Office Automation — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is already excluded by .gitignore.
# ============================================================

# ----------------------------------------------------------
# PORT
# The port the Node.js server listens on.
# Hosting platforms (Render, Railway, Fly.io) inject this
# automatically; you normally do NOT set it manually there.
# For local development the server defaults to 5000.
# ----------------------------------------------------------
PORT=5000

# ----------------------------------------------------------
# FRONTEND_URL
# Comma-separated list of allowed CORS origins.
# Must match the exact URL(s) where your frontend is hosted.
# Include http:// for local dev, https:// for production.
# ----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Production example (replace with your actual Vercel URL):
# FRONTEND_URL=https://smart-office.vercel.app
