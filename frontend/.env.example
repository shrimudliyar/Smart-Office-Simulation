# ============================================================
# Smart Office Automation — Frontend Environment Variables
# ============================================================
# Copy this file to .env (or .env.local) and fill in values.
# NEVER commit .env — it is already excluded by .gitignore.
#
# Vite reads variables prefixed with VITE_ at build time and
# embeds them in the bundle. Set these in your hosting
# platform's build environment settings before deploying.
# ============================================================

# ----------------------------------------------------------
# VITE_WS_URL
# WebSocket URL of the deployed backend.
# Use ws:// for local development, wss:// for production
# (the hosting provider's HTTPS proxy handles TLS).
# ----------------------------------------------------------
VITE_WS_URL=ws://localhost:5000
# Production example (replace with your actual Render URL):
# VITE_WS_URL=wss://smart-office-backend.onrender.com

# ----------------------------------------------------------
# VITE_API_URL  (reserved for future REST calls from frontend)
# HTTP base URL of the deployed backend.
# ----------------------------------------------------------
VITE_API_URL=http://localhost:5000
# Production example:
# VITE_API_URL=https://smart-office-backend.onrender.com
