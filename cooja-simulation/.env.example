# ============================================================
# Smart Office Automation — Cooja Bridge Environment Variables
# ============================================================
# Copy this file to .env and source it before running the bridge:
#   export $(cat .env | xargs)   (Linux/macOS)
#   $env:NODE_API="..."          (PowerShell)
#
# NEVER commit .env — it is already excluded by .gitignore.
# ============================================================

# ----------------------------------------------------------
# NODE_API
# The backend endpoint that receives sensor data from Cooja.
# Use http:// for local dev, https:// for production.
# ----------------------------------------------------------
NODE_API=http://localhost:5000/api/office/update
# Production example (replace with your actual Render URL):
# NODE_API=https://smart-office-backend.onrender.com/api/office/update
