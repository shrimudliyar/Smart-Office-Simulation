# ============================================================
# Smart Office Automation — Root .gitignore
# ============================================================

# ── Node / NPM ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ── Frontend build output ────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/

# ── Environment files (never commit secrets) ─────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
# Keep .env.example files (they document required vars, no secrets)
!**/.env.example

# ── Cooja / Contiki-NG simulation build artefacts ────────────
# Compiled firmware & object files
*.elf
*.co
*.sky
*.cooja
*.cm5441*
*.motelist
# Contiki build directories
obj_cooja/
cooja-simulation/build/
# Java Cooja log files
cooja-simulation/COOJA.log
cooja-simulation/COOJA.testlog
# Simulation temporary dirs generated by Cooja
cooja-simulation/tmp/
# C compiler artefacts inside the repo
*.o
*.a
*.d
# Keep all source files: *.c, *.h, *.csc, Makefile, Makefile.include, README
!*.c
!*.h
!*.csc
!Makefile
!*.md

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
.idea/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/

# ── Misc ─────────────────────────────────────────────────────
*.local
*.bak
*.tmp
